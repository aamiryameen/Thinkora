# ─────────────────────────────────────────────────────────────────────
# Thinkora environment variables
# Copy this file to `.env` and fill in your own values.
# `.env` is git-ignored; never commit real secrets.
# ─────────────────────────────────────────────────────────────────────

# ── Supabase (client-safe — these ship in the app) ──────────────────
# From: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key-here

# ── Server-only secrets (DO NOT put in the app) ─────────────────────
# These go into Supabase Dashboard → Edge Functions → Secrets
# Listed here only as a reference for what you'll set on the server.
#
# GEMINI_API_KEY=set-this-in-supabase-secrets-not-here
# SUPABASE_SERVICE_ROLE_KEY=set-this-in-supabase-secrets-not-here
