<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg_green"
    android:padding="16dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp">

        <TextView
            android:id="@+id/widget_habits_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Today's Habits"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_habits_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0/0"
            android:textColor="#FFFFFFAA"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#FFFFFF30"
        android:layout_marginBottom="10dp"/>

    <!-- Habit rows (up to 4) -->
    <LinearLayout
        android:id="@+id/widget_habit_row_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="3dp"
        android:visibility="gone">
        <TextView
            android:id="@+id/widget_habit_dot_1"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:text="●"
            android:textColor="#FFFFFF60"
            android:textSize="10sp"
            android:gravity="center"
            android:layout_marginEnd="8dp"/>
        <TextView
            android:id="@+id/widget_habit_name_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end"/>
        <TextView
            android:id="@+id/widget_habit_streak_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFFAA"
            android:textSize="11sp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_habit_row_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="3dp"
        android:visibility="gone">
        <TextView
            android:id="@+id/widget_habit_dot_2"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:text="●"
            android:textColor="#FFFFFF60"
            android:textSize="10sp"
            android:gravity="center"
            android:layout_marginEnd="8dp"/>
        <TextView
            android:id="@+id/widget_habit_name_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end"/>
        <TextView
            android:id="@+id/widget_habit_streak_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFFAA"
            android:textSize="11sp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_habit_row_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="3dp"
        android:visibility="gone">
        <TextView
            android:id="@+id/widget_habit_dot_3"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:text="●"
            android:textColor="#FFFFFF60"
            android:textSize="10sp"
            android:gravity="center"
            android:layout_marginEnd="8dp"/>
        <TextView
            android:id="@+id/widget_habit_name_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end"/>
        <TextView
            android:id="@+id/widget_habit_streak_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFFAA"
            android:textSize="11sp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_habit_row_4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="3dp"
        android:visibility="gone">
        <TextView
            android:id="@+id/widget_habit_dot_4"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:text="●"
            android:textColor="#FFFFFF60"
            android:textSize="10sp"
            android:gravity="center"
            android:layout_marginEnd="8dp"/>
        <TextView
            android:id="@+id/widget_habit_name_4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end"/>
        <TextView
            android:id="@+id/widget_habit_streak_4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFFAA"
            android:textSize="11sp"/>
    </LinearLayout>

    <!-- Empty state -->
    <TextView
        android:id="@+id/widget_habits_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="No habits yet. Add habits in the app!"
        android:textColor="#FFFFFFAA"
        android:textSize="13sp"
        android:gravity="center"
        android:visibility="gone"/>

</LinearLayout>
